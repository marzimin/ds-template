# --- OS cruft (macOS) ---
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.ipynb_checkpoints/

# --- Virtual environments ---
.venv/
venv/
env/
env.bak/
.python-version

# --- Claude ---
.claude/

# --- Packaging / build artefacts ---
build/
dist/
wheels/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/
*.whl
*.manifest
*.spec

# --- Logs & runtime files ---
*.log
log.txt
logs/
coverage.xml
htmlcov/
.coverage
.coverage.*
.cache/

# --- Test reports ---
test-output.xml

# --- Images generated during runs ---
# Scoped to where runs actually write. A bare `*.png` also swallows frontend
# assets such as frontend/public/logo.png, with no error to tell you.
/outputs/**/*.png
/data/**/*.png

# --- Tools / IDEs ---
.idea/
# Ignore .vscode contents but keep settings.json tracked: it points editors at
# backend/.venv, which is not guessable from the repository root. This must use
# .vscode/* rather than .vscode/ — git does not descend into an excluded
# directory, so a negation inside one never applies.
.vscode/*
!.vscode/settings.json
*~
*.swp
*.swo

# --- Pre-commit (caches) ---
.pre-commit*
!.pre-commit-config.yaml

# --- Environment & secrets ---
.env
.env.*
!.env.example

# --- Documentation builds (Sphinx) ---
docs/_build/
docs/_autoapi/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Data ---
# data/ and outputs/ live at the repository root, alongside cfg/, because they
# are the user-configurable surface of the template rather than backend code.
# Ignore all data files; track only directory structure via .gitkeep.
# data/raw/       — drop raw input files here before running the pipeline
# data/processed/ — prepared (*_prepared.csv) and trained (*_trained.csv) outputs
data/**
!data/raw/
!data/raw/.gitkeep
!data/processed/
!data/processed/.gitkeep

# --- Notebooks (keep structure, ignore contents except tracked files) ---
backend/notebooks/**
!backend/notebooks/example_notebook.ipynb

# --- ML artefacts / outputs ---
# Anchored with a leading slash so they match only at the repository root.
# Unanchored, these match at any depth and silently ignore ordinary source
# directories — frontend/src/models/, frontend/src/pages/runs/, and
# frontend/src/lib/artifacts/ would all vanish without a warning.
/artifacts/
/outputs/
/models/
/checkpoints/
/runs/

# --- Model files (binary, large) ---
*.ckpt
*.pth
*.pt
*.h5
*.hdf5
*.onnx
*.tflite
*.pb
*.keras
*.pkl
*.joblib
*.npz
*.npy

# --- MLflow local tracking ---
mlruns/
mlartifacts/
mlflow.db
mlruns.db

# --- Local databases ---
*.sqlite
*.sqlite3
*.db
*.db-journal
