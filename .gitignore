# --- Data ---
# data/ and outputs/ live at the repository root, alongside cfg/, because they
# are the user-configurable surface of the template rather than backend code.
# Ignore all data files; track only directory structure via .gitkeep.
# data/raw/       — drop raw input files here before running the pipeline
# data/processed/ — prepared (*_prepared.csv) and trained (*_trained.csv) outputs
data/**
!data/raw/
!data/raw/.gitkeep
!data/processed/
!data/processed/.gitkeep

# --- Notebooks (keep structure, ignore contents except tracked files) ---
backend/notebooks/**
!backend/notebooks/example_notebook.ipynb

# --- ML artefacts / outputs ---
artifacts/
outputs/
models/
checkpoints/
runs/

