# This file lives at the repository root and is the single .env shared by the
# backend, the container build, and (later) docker compose.
# Copy it with: cp .env.example .env

# MLflow tracking URI for native tooling (`make mlflow`, `make api`,
# `make pipeline`). Left unset, it defaults to http://127.0.0.1:$MLFLOW_PORT
# (see MLFLOW_PORT below), so setting that one variable moves both the native
# server and where native tooling looks for it. Set this only to point
# somewhere MLFLOW_PORT can't describe, such as a remote tracking server.
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Output directories for local runs, relative to the repository root
# (defaults used if not set).
LOCAL_EDA_PATH=outputs/eda
LOCAL_REPORTS_PATH=outputs/reports
LOCAL_PLOTS_PATH=outputs/plots

# Browser origins allowed to call the API, comma-separated. Defaults to the
# Vite dev server. A browser blocks calls from any origin not listed here.
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How often the API re-checks the Model Registry for a newer version, in
# seconds. The check is a metadata query and only triggers a reload when the
# version has actually changed, so training while the API runs is picked up on
# its own. Set 0 to disable it and rely on POST /api/predict/reload instead.
# MODEL_REFRESH_SECONDS=30

# Overrides the repository root used to resolve cfg/, data/ and outputs/.
# Normally left unset — it is inferred from the backend package location.
# The container image sets it explicitly.
# DS_PROJECT_ROOT=/opt/app

# Ports published by docker compose. The container ports never change, so
# nothing else has to follow when you move one. 5000 in particular is often
# taken by the AirPlay Receiver on macOS. MLFLOW_PORT doubles as the native
# default above, so a value here is picked up by `make mlflow` and by native
# tooling looking for it, not just by the Docker containers.
#
# To retrain against a stack started with `make demo` / `make up`, use
# `make docker-pipeline` rather than `make pipeline` — it runs inside the
# compose network and reaches MLflow there directly, so it works regardless
# of what MLFLOW_PORT is set to on the host.
# MLFLOW_PORT=5000
# API_PORT=8000
# WEB_PORT=5173

# --- Receiving data from de-template -----------------------------------------
# Nothing to set here. The upstream data engineering project writes exported
# marts straight into this project's data/raw/ by setting DS_DATA_RAW_DIR in
# *its* .env to point at that directory. From this side an exported file is
# just a CSV in data/raw/ — name it in cfg/config.yaml and run the pipeline.
# See docs/handoff.md.
