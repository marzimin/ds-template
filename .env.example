# This file lives at the repository root and is the single .env shared by the
# backend, the container build, and (later) docker compose.
# Copy it with: cp .env.example .env

# MLflow tracking URI. The default template expects this server to be running.
# Start it with: uv run mlflow server --host 127.0.0.1 --port 5000
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Output directories for local runs, relative to the repository root
# (defaults used if not set).
LOCAL_EDA_PATH=outputs/eda
LOCAL_REPORTS_PATH=outputs/reports
LOCAL_PLOTS_PATH=outputs/plots

# Browser origins allowed to call the API, comma-separated. Defaults to the
# Vite dev server. A browser blocks calls from any origin not listed here.
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Overrides the repository root used to resolve cfg/, data/ and outputs/.
# Normally left unset — it is inferred from the backend package location.
# The container image sets it explicitly.
# DS_PROJECT_ROOT=/opt/app

# Ports published by docker compose. The container ports never change, so
# nothing else has to follow when you move one. 5000 in particular is often
# taken by the AirPlay Receiver on macOS.
# MLFLOW_PORT=5000
# API_PORT=8000
# WEB_PORT=5173

# --- Receiving data from de-template -----------------------------------------
# Nothing to set here. The upstream data engineering project writes exported
# marts straight into this project's data/raw/ by setting DS_DATA_RAW_DIR in
# *its* .env to point at that directory. From this side an exported file is
# just a CSV in data/raw/ — name it in cfg/config.yaml and run the pipeline.
# See docs/handoff.md.
