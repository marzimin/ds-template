# MLflow tracking URI. The default template expects this server to be running.
# Start it with: uv run mlflow server --host 127.0.0.1 --port 5000
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Output directories for local runs (defaults used if not set)
LOCAL_REPORTS_PATH=outputs/reports
LOCAL_PLOTS_PATH=outputs/plots
